<% content_for :title, "#{@project.title} | Project Room" %>

<!-- HEADER -->
<section class="bg-[#202326] px-5 py-16 text-white sm:py-20">

  <div class="mx-auto max-w-7xl">

    <%= link_to projects_path(category: @project.category.slug),
                class: "mb-8 inline-flex items-center text-sm text-[#D8B48C] transition hover:text-white" do %>

      ← Wróć do realizacji

    <% end %>

    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-[#C99563]">
      <%= @project.category.name %>
    </p>

    <h1 class="max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl">
      <%= @project.title %>
    </h1>

  </div>

</section>


<!-- PROJECT DETAILS -->
<section class="bg-[#F8F7F4] px-5 py-16 sm:py-20">

  <div class="mx-auto max-w-7xl">

    <!-- DESCRIPTION -->
    <div class="mb-14 max-w-3xl">

      <h2 class="mb-6 text-2xl font-semibold text-[#252525]">
        O realizacji
      </h2>

      <div class="whitespace-pre-line text-base leading-8 text-gray-600"><%= @project.description %></div>

    </div>


    <!-- GALLERY -->
    <% if @project.images.attached? %>

      <div class="mb-8">

        <h2 class="text-2xl font-semibold text-[#252525]">
          Galeria zdjęć
        </h2>

        <p class="mt-3 text-sm text-gray-600">
          Kliknij zdjęcie, aby otworzyć galerię.
        </p>

      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">

        <% @project.images.each do |image| %>

          <a href="<%= url_for(image) %>"
             target="_blank"
             rel="noopener noreferrer"
             class="group block h-72 overflow-hidden rounded-2xl bg-[#EEE9E1]">

            <%= image_tag image,
                          alt: @project.title,
                          loading: "lazy",
                          class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>

          </a>

        <% end %>

      </div>

    <% else %>

      <div class="rounded-2xl bg-white p-10 text-center text-gray-600">
        Zdjęcia tej realizacji pojawią się wkrótce.
      </div>

    <% end %>

  </div>

</section>


<!-- CONTACT CTA -->
<section class="bg-[#252729] px-5 py-16 text-center text-white">

  <div class="mx-auto max-w-3xl">

    <h2 class="text-3xl font-semibold">
      Planujesz remont?
    </h2>

    <p class="mt-5 text-gray-300">
      Skontaktuj się z nami telefonicznie lub mailowo.
    </p>

    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">

      <a href="tel:+48514756878"
         class="inline-flex min-h-12 items-center justify-center rounded-lg bg-[#C99563] px-8 py-4 text-sm font-semibold text-[#202326] transition hover:bg-[#D8B48C]">
        Zadzwoń: 514 756 878
      </a>

      <a href="mailto:projectroomwaw@gmail.com"
         class="inline-flex min-h-12 items-center justify-center rounded-lg border border-white/30 px-8 py-4 text-sm font-semibold text-white transition hover:bg-white/10">
        Napisz e-mail
      </a>

    </div>

  </div>

</section>