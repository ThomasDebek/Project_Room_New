<% content_for :title, "Nasze realizacje | Project Room" %>

<!-- HEADER -->
<section class="bg-[#202326] px-5 py-20 text-white sm:py-24">

  <div class="mx-auto max-w-7xl">

    <%= link_to root_path,
                class: "mb-8 inline-flex items-center text-sm text-[#D8B48C] transition hover:text-white" do %>
      ← Strona główna
    <% end %>

    <p class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-[#C99563]">
      Portfolio Project Room
    </p>

    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
      Nasze realizacje
    </h1>

    <p class="mt-6 max-w-2xl text-base leading-8 text-gray-300">
      Zobacz wykonane przez nas remonty i wykończenia wnętrz.
      Poznaj nasze realizacje łazienek, kuchni oraz mieszkań.
    </p>

  </div>

</section>


<!-- PROJECTS -->
<section class="min-h-[500px] bg-[#F8F7F4] px-5 py-16 sm:py-20">

  <div class="mx-auto max-w-7xl">

    <!-- CATEGORY FILTERS -->
    <div class="mb-12 flex flex-wrap gap-3">

      <%= link_to "Wszystkie",
                  projects_path,
                  class: "rounded-full px-6 py-3 text-sm font-semibold transition #{'bg-[#202326] text-white' if @selected_category.nil?} #{'border border-[#DDD5CB] bg-white text-[#252525] hover:border-[#C99563]' if @selected_category.present?}" %>

      <% @categories.each do |category| %>

        <% active = @selected_category == category %>

        <%= link_to category.name,
                    projects_path(category: category.slug),
                    class: "rounded-full px-6 py-3 text-sm font-semibold transition #{active ? 'bg-[#202326] text-white' : 'border border-[#DDD5CB] bg-white text-[#252525] hover:border-[#C99563]'}" %>

      <% end %>

    </div>


    <!-- GRID -->
    <% if @projects.any? %>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">

        <% @projects.each do |project| %>

          <%= link_to project_path(project),
                      class: "group overflow-hidden rounded-2xl bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl" do %>

            <!-- IMAGE -->
            <div class="h-72 overflow-hidden bg-[#EEE9E1]">

              <% if project.cover_image.present? %>

                <%= image_tag project.cover_image,
                              alt: project.title,
                              loading: "lazy",
                              class: "h-full w-full object-cover transition duration-500 group-hover:scale-105" %>

              <% else %>

                <div class="flex h-full items-center justify-center text-sm text-gray-500">
                  Zdjęcie w przygotowaniu
                </div>

              <% end %>

            </div>


            <!-- CONTENT -->
            <div class="p-7">

              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.15em] text-[#A77549]">
                <%= project.category.name %>
              </p>

              <h2 class="text-xl font-semibold text-[#252525]">
                <%= project.title %>
              </h2>

              <p class="mt-4 line-clamp-3 text-sm leading-7 text-gray-600">
                <%= project.description %>
              </p>

              <span class="mt-6 inline-flex items-center text-sm font-semibold text-[#A77549]">
                Zobacz realizację
                <span class="ml-2">→</span>
              </span>

            </div>

          <% end %>

        <% end %>

      </div>

    <% else %>

      <!-- EMPTY STATE -->
      <div class="rounded-2xl border border-[#E4DED5] bg-white px-6 py-20 text-center">

        <h2 class="text-2xl font-semibold text-[#252525]">
          Realizacje w przygotowaniu
        </h2>

        <p class="mx-auto mt-4 max-w-lg text-gray-600">
          Wkrótce pojawią się tutaj zdjęcia naszych wykonanych remontów.
        </p>

      </div>

    <% end %>

  </div>

</section>