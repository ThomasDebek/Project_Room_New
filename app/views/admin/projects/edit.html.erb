<% content_for :title, "Edytuj realizację | Project Room" %>

<section class="min-h-screen bg-[#F8F7F4] px-5 py-12 sm:py-16">

  <div class="mx-auto max-w-4xl">

    <%= link_to "← Powrót do realizacji",
                admin_projects_path,
                class: "text-sm font-medium text-[#666666] transition hover:text-[#C99563]" %>

    <div class="mt-10">

      <p class="mb-3 text-xs font-semibold uppercase tracking-[0.25em] text-[#A77549]">
        Panel administratora
      </p>

      <h1 class="text-3xl font-semibold text-[#252525] sm:text-4xl">
        Edytuj realizację
      </h1>

      <p class="mt-3 text-sm text-[#666666]">
        Zmień informacje dotyczące realizacji.
      </p>

    </div>

    <div class="mt-10 rounded-2xl border border-[#E4DED5] bg-white p-6 shadow-sm sm:p-10">

      <%= render "form" %>

    </div>

  </div>

</section>